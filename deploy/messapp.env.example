# Production API settings. Save as server/.env on the server.
NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://mess.shadiqur.com
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Set these to the existing MySQL server and mess database credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mess
DB_USER=messapp
DB_PASSWORD=replace-with-a-strong-password
